{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexbar.dev/schemas/codexbar-linux/refresh-result.schema.json",
  "title": "CodexBar Linux Refresh Result",
  "type": "object",
  "required": ["schemaVersion", "refreshId", "status", "startedAt", "finishedAt", "durationMs", "reason", "providers", "cacheWritten"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "refreshId": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "partial", "error", "busy", "noop"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "enum": ["manual", "scheduled", "startup", "settings_changed", "retry", "test"] },
    "cacheWritten": { "type": "boolean" },
    "snapshotGeneratedAt": { "type": ["string", "null"], "format": "date-time" },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider", "status"],
        "additionalProperties": false,
        "properties": {
          "provider": { "type": "string" },
          "status": { "type": "string", "enum": ["ok", "stale", "skipped", "unauthenticated", "cookie_rejected", "missing_dependency", "provider_unavailable", "parse_error", "timeout", "error"] },
          "sourceAdapter": { "type": ["string", "null"], "enum": ["upstream_cli", "linux_web", "cache", "fixture", "synthetic", "none", null] },
          "diagnosticCodes": { "type": "array", "items": { "type": "string" }, "default": [] }
        }
      }
    },
    "diagnosticCodes": { "type": "array", "items": { "type": "string" }, "default": [] }
  }
}
