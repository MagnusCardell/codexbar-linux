{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexbar.dev/schemas/codexbar-linux/diagnostics.schema.json",
  "title": "CodexBar Linux Diagnostics",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "scope", "events", "redaction"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "scope": { "type": "string", "enum": ["global", "provider", "browser_import", "upstream_cli", "settings"] },
    "provider": { "type": ["string", "null"] },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnosticEvent" }
    },
    "redaction": {
      "type": "object",
      "required": ["applied", "policyVersion"],
      "additionalProperties": false,
      "properties": {
        "applied": { "type": "boolean", "const": true },
        "policyVersion": { "type": "integer", "const": 1 },
        "notes": { "type": "array", "items": { "type": "string" }, "default": [] }
      }
    }
  },
  "$defs": {
    "sourceAdapter": {
      "type": ["string", "null"],
      "enum": ["upstream_cli", "linux_web", "cache", "fixture", "synthetic", "none", null]
    },
    "diagnosticEvent": {
      "type": "object",
      "required": ["code", "severity", "safeMessage", "timestamp", "redacted"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "error"] },
        "safeMessage": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "provider": { "type": ["string", "null"] },
        "sourceAdapter": { "$ref": "#/$defs/sourceAdapter" },
        "recoverable": { "type": "boolean" },
        "details": {
          "type": "object",
          "description": "Small, redacted machine-readable details only. No raw cookies, tokens, headers, profile paths, emails, or provider payloads.",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          },
          "default": {}
        },
        "redacted": {
          "type": "object",
          "required": ["applied"],
          "additionalProperties": false,
          "properties": {
            "applied": { "type": "boolean", "const": true },
            "classes": { "type": "array", "items": { "type": "string" }, "default": [] }
          }
        }
      }
    }
  }
}
