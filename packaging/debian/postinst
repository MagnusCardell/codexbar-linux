#!/bin/sh
set -e

compile_gsettings_schemas() {
    if command -v glib-compile-schemas >/dev/null 2>&1; then
        glib-compile-schemas /usr/share/glib-2.0/schemas
    else
        echo "codexbar-linux: glib-compile-schemas not found; install libglib2.0-bin before enabling the extension" >&2
    fi
}

case "$1" in
    configure)
        compile_gsettings_schemas
        echo "codexbar-linux: run codexbar-linux-setup as the desktop user to verify D-Bus activation and enable the GNOME extension." >&2
        ;;
esac

exit 0
